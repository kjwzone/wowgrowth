# 기업마당 API — wowgrowth-kd4u Vercel Environment Variables
BIZINFO_API_KEY=your-bizinfo-api-key

# 사업계획서 AI 생성 (Gemini) — Vercel + 로컬 동일
GEMINI_API_KEY=your-gemini-api-key
# 권장: gemini-2.5-pro (고품질·심화 생성)
GEMINI_MODEL=gemini-2.5-pro
# 빠른 초안 생성 (미설정 시 gemini-2.5-flash)
GEMINI_FAST_MODEL=gemini-2.5-flash

# 합격 샘플·정부 양식 PDF URL (프롬프트 컨텍스트 메타)
BUSINESS_PLAN_SAMPLE_PDF_URL=
BUSINESS_PLAN_FORM_PDF_URL=
