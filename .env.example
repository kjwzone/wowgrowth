NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DB 마이그레이션: Dashboard → Settings → Database → Database password
SUPABASE_DB_PASSWORD=your-database-password

# AI (server-only) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# 기본: gemini-2.5-flash (폴백: gemini-2.5-flash-lite)
# gemini-2.0-* 모델은 2025년 이후 API에서 중단됨
GEMINI_MODEL=gemini-2.5-flash

# Optional: 사업계획서 프롬프트에 PDF 첨부 안내용 (MVP는 URL만 메타 표시)
# BUSINESS_PLAN_SAMPLE_PDF_URL=
# BUSINESS_PLAN_FORM_PDF_URL=
